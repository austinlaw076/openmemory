{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "austin-openmemory",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/mcp",
      "/mcp/*",
      "/health",
      "/login",
      "/consent",
      "/consent/*",
      "/.well-known",
      "/.well-known/*"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MemoryGraph"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEMORY_GRAPHS",
        "class_name": "MemoryGraph"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "MEMORY_VECTORS",
      "index_name": "austin-openmemory-vectors"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEMORY_EXPORTS",
      "bucket_name": "austin-openmemory-exports"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "OPENMEMORY_ANALYTICS",
      "dataset": "austin_openmemory_events"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEMORY_EXTRACTION_QUEUE",
        "queue": "austin-openmemory-memory-extraction"
      },
      {
        "binding": "SOURCE_INGESTION_QUEUE",
        "queue": "austin-openmemory-source-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "austin-openmemory-memory-extraction",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "austin-openmemory-memory-extraction-dlq"
      },
      {
        "queue": "austin-openmemory-source-ingestion",
        "max_batch_size": 4,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "austin-openmemory-source-ingestion-dlq"
      }
    ]
  },
  "workflows": [
    {
      "binding": "MEMORY_EXTRACTION_WORKFLOW",
      "name": "austin-openmemory-memory-extraction",
      "class_name": "MemoryExtractionWorkflow"
    },
    {
      "binding": "SOURCE_INGESTION_WORKFLOW",
      "name": "austin-openmemory-source-ingestion",
      "class_name": "SourceIngestionWorkflow"
    }
  ],
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-m3"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "austin-openmemory-auth",
      "database_id": "8818d6e4-f8e0-4549-862e-578938df0242",
      "migrations_dir": "drizzle"
    }
  ]
}
